      "topicId": "math-topic-04",
      "tier": 2,
      "questionText": "Solve the equation $2^{2x+1} - 9(2^x) + 4 = 0$.",
      "options": [
        "x = 2 or x = -1",
        "x = 4 or x = 0.5",
        "x = 2 or x = 1",
        "x = -2 or x = 1"
      ],
      "correctAnswer": "x = 2 or x = -1",
      "solution": {
        "formulaSetup": "Hidden quadratic substitution: Let $u = 2^x$. Then $2^{2x+1} = 2(2^{2x}) = 2(2^x)^2 = 2u^2$.",
        "steps": [
          "1. Rewrite using index laws: $$2(2^x)^2 - 9(2^x) + 4 = 0$$",
          "2. Substitute $u = 2^x$: $$2u^2 - 9u + 4 = 0$$",
          "3. Factorise: $$(2u - 1)(u - 4) = 0 \\implies u = 4 \\quad \\text{or} \\quad u = \\frac{1}{2}$$",
          "4. Substitute back $2^x = u$:",
          "   - $2^x = 4 = 2^2 \\implies x = 2$",
          "   - $2^x = \\frac{1}{2} = 2^{-1} \\implies x = -1$"
        ],
        "finalAnswer": "\\mathbf{x = 2 \\quad \\text{or} \\quad x = -1}",
        "commonTrap": "Stopping at $u = 4$ and $u = 0.5$. The question asks for $x$, not $u$."
      }
    },
